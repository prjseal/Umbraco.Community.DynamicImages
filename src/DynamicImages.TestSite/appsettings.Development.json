{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      }
    }
  },

  "//": [
    "A v1 DynamicImages block, kept deliberately. v2 stores templates in the database, but it",
    "imports a block like this one the first time it starts against an empty template table - so",
    "booting this site is itself a test of the v1 -> v2 import path. The layers below cover a text",
    "layer, a date-formatted text layer, a static image overlay and a circular avatar sourced from",
    "a content property. Editing them no longer changes what renders: once imported, the template",
    "is edited in the backoffice designer."
  ],
  "DynamicImages": {
    "Enabled": true,
    "Instructions": [
      {
        "MediaFolder": "Dynamic Images",
        "DocTypeAliases": [ "issue" ],
        "Author": "Paul Seal",
        "TargetPropertyAlias": "socialImage",
        "SourceImagePath": "/assets/skrift-background.png",
        "Layers": [
          {
            "LayerType": 0,
            "SourcePropertyAlias": "name",
            "MaxWidth": 600,
            "xPosition": 50,
            "yPosition": 60,
            "Colour": "#c13ea9",
            "Font": "OpenSans_Large"
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "author",
            "xPosition": 178,
            "yPosition": 526,
            "Colour": "#c13ea9",
            "Font": "OpenSans_Small"
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "issueNumber",
            "xPosition": 526,
            "yPosition": 526,
            "Colour": "#c13ea9",
            "Font": "OpenSans_Small"
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "issueDate",
            "DateFormat": "dd MMMM yyyy",
            "xPosition": 606,
            "yPosition": 526,
            "Colour": "#ffffff",
            "Font": "OpenSans_Small"
          },
          {
            "LayerType": 1,
            "ImagePath": "/assets/github.png",
            "xPosition": 850,
            "yPosition": 20,
            "Width": 120,
            "Height": 120,
            "Opacity": 0.9
          },
          {
            "LayerType": 1,
            "SourcePropertyAlias": "authorPhoto",
            "xPosition": 50,
            "yPosition": 480,
            "Width": 100,
            "Height": 100,
            "CornerRadius": 50,
            "Opacity": 1.0
          }
        ]
      }
    ],
    "Fonts": [
      {
        "FamilyName": "OpenSans",
        "Path": "/assets/fonts/OpenSans-Regular.ttf",
        "Styles": [
          { "Name": "Small", "Size": 30, "Style": 1 },
          { "Name": "Large", "Size": 80, "Style": 1 }
        ]
      }
    ]
  }
}
