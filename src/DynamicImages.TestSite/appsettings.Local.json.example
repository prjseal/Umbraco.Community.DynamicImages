{
  "//": [
    "Copy this file to appsettings.Local.json (which is gitignored) to have the site install",
    "itself on first run instead of showing the setup wizard. Program.cs loads that file in",
    "DEBUG builds only. Never commit real credentials - these are local development values for a",
    "throwaway SQLite database."
  ],
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Test Editor",
        "UnattendedUserEmail": "test@example.com",
        "UnattendedUserPassword": "CHANGE-ME-local-only-1234"
      }
    }
  }
}
