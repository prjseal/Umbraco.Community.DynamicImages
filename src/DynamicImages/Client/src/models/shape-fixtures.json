        [0.933, 0.75],
        [0.5, 1.0],
        [0.067, 0.75],
        [0.067, 0.25]
      ]
    },
    {
      "name": "a five-point star with the default inner ratio",
      "kind": "star",
      "sides": 5,
      "innerRatio": 0.5,
      "expected": [
        [0.5, 0.0],
        [0.6469, 0.2977],
        [0.9755, 0.3455],
        [0.7378, 0.5773],
