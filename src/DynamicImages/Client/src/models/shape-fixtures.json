    {
      "name": "a four-point star with a deep inner ratio",
      "kind": "star",
      "sides": 4,
      "innerRatio": 0.25,
      "expected": [
        [0.5, 0.0],
        [0.5884, 0.4116],
        [1.0, 0.5],
        [0.5884, 0.5884],
        [0.5, 1.0],
        [0.4116, 0.5884],
        [0.0, 0.5],
        [0.4116, 0.4116]
      ]
    },
    {
      "name": "fewer than three sides is drawn as a triangle",
      "kind": "polygon",
      "sides": 2,
      "innerRatio": 0.5,
      "expected": [
        [0.5, 0.0],
