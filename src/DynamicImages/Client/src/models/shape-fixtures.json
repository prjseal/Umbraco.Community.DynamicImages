{
  "_comment": "Shared by Client/src/models/shape-geometry.test.ts and test/DynamicImages.Tests/ShapeGeometryTests.cs. Edit in one place only. Vertices are in the unit square, centre (0.5, 0.5), radius 0.5; a polygon's first point is at the top and a star alternates outer and inner radius. Sides clamp to 3..12 and the inner ratio to 0.1..0.9 before anything is generated.",
  "cases": [
    {
      "name": "a rectangle has no vertices - it is a primitive on both sides",
      "kind": "rectangle",
      "sides": 4,
      "innerRatio": 0.5,
      "expected": []
    },
    {
      "name": "an ellipse has no vertices - it is a primitive on both sides",
      "kind": "ellipse",
      "sides": 4,
      "innerRatio": 0.5,
      "expected": []
    },
    {
      "name": "a triangle points up",
      "kind": "polygon",
      "sides": 3,
      "innerRatio": 0.5,
      "expected": [
        [0.5, 0.0],
        [0.933, 0.75],
        [0.067, 0.75]
      ]
    },
    {
      "name": "four sides is a diamond, not a square",
      "kind": "polygon",
      "sides": 4,
      "innerRatio": 0.5,
      "expected": [
        [0.5, 0.0],
        [1.0, 0.5],
        [0.5, 1.0],
        [0.0, 0.5]
      ]
    },
    {
      "name": "a pentagon",
      "kind": "polygon",
      "sides": 5,
      "innerRatio": 0.5,
      "expected": [
        [0.5, 0.0],
        [0.9755, 0.3455],
        [0.7939, 0.9045],
        [0.2061, 0.9045],
        [0.0245, 0.3455]
      ]
    },
    {
      "name": "a hexagon",
      "kind": "polygon",
      "sides": 6,
      "innerRatio": 0.5,
      "expected": [
