{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    // Lit's @property/@state decorators assign in the constructor; class fields would
    // shadow them and the reactive accessors would never fire.
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // "node" is for the source-scanning guard tests, which read the client's own .ts files off
    // disk. Nothing under src/ that ships to the browser imports from node:*.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src"]
}
