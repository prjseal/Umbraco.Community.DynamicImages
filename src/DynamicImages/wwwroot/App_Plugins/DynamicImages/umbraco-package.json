{
  "$schema": "../../../Client/node_modules/@umbraco-cms/backoffice/umbraco-package-schema.json",
  "name": "DynamicImages",
  "version": "1.0.0",
  "allowTelemetry": false,

  "//": "Umbraco reads this file before the bundle loads, so everything here paints immediately. That is why the section chrome - the sidebar app, the menu and the Health link-kind menu item, none of which needs an element - lives here rather than in manifests.ts (the Templates and Fonts trees are tree-kind menu items, which need their trees registered first, so they are in the bundle): a cold load of the section used to show an entirely empty screen, no sidebar and no spinner, while the 240 KB entry point downloaded. Anything that references an element or the workspace context stays in manifests.ts, where a renamed export is a build error instead of a blank panel at runtime.",

  "extensions": [
    {
      "type": "section",
      "alias": "DynamicImages.Section",
      "name": "Dynamic Images Section",
      "meta": {
        "label": "#dynamicImages_sectionName",
        "pathname": "dynamic-images"
      },
      "weight": -5
    },
    {
      "type": "sectionSidebarApp",
      "kind": "menu",
      "alias": "DynamicImages.SidebarApp",
      "name": "Dynamic Images Sidebar",
      "meta": {
        "label": "#dynamicImages_sectionName",
        "menu": "DynamicImages.Menu"
      },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "DynamicImages.Section" }]
    },
    {
      "type": "menu",
      "alias": "DynamicImages.Menu",
      "name": "Dynamic Images Menu"
    },
    {
      "type": "menuItem",
      "kind": "link",
      "alias": "DynamicImages.MenuItem.Health",
      "name": "Dynamic Images Health Menu Item",
      "weight": 90,
      "meta": {
        "label": "Health",
        "icon": "icon-stethoscope",
        "menus": ["DynamicImages.Menu"],
        "href": "section/dynamic-images/dashboard/health"
      }
    },
    {
      "type": "backofficeEntryPoint",
      "alias": "DynamicImages.EntryPoint",
      "name": "Dynamic Images Entry Point",
      "js": "/App_Plugins/DynamicImages/dynamic-images.js"
    },
    {
      "type": "localization",
      "alias": "DynamicImages.Lang.EnUS",
      "name": "Dynamic Images English",
      "meta": {
        "culture": "en-us"
      },
      "js": "/App_Plugins/DynamicImages/lang/en-us.js"
    }
  ]
}
