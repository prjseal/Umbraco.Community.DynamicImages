<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Umbraco.Community.DynamicImages</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Serve wwwroot/App_Plugins/... at /App_Plugins/... instead of /_content/<package id>/... -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.DynamicImages</PackageId>
    <Product>Umbraco.Community.DynamicImages</Product>
    <Title>Dynamic Images</Title>
    <Version>1.0.0</Version>
    <Authors>Paul Seal</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Paul Seal</Copyright>
    <Description>Generates Open Graph / social share images from your content on publish, designed in a drag-and-drop backoffice section instead of hand-written configuration.</Description>
    <PackageTags>umbraco;umbraco-marketplace;opengraph;og-image;social;images;backoffice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- nuget.org and the Umbraco Marketplace both take the package logo from here; there is no
         Marketplace field for it. PackageIconUrl is deprecated, so the file is embedded. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/prjseal/Umbraco.Community.DynamicImages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/prjseal/Umbraco.Community.DynamicImages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- A .snupkg alongside the package, so a consumer can step into this code from their own
         debugger. SourceLink ships in the SDK, so these need no PackageReference. None of it
         can be added to a version after the fact - only to the next one. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- RegenerationScope and friends are implementation detail, not package API; the tests still
         have to be able to open the scope to assert the publish handler stands down inside it. -->
    <InternalsVisibleTo Include="DynamicImages.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.5.3" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <!-- Keep the npm workspace out of static web assets and the package -->
    <Content Remove="Client\**" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>
</Project>
