<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Umbraco.Community.DynamicImages</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Serve wwwroot/App_Plugins/... at /App_Plugins/... instead of /_content/<package id>/... -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <IsPackable>true</IsPackable>
    <PackageId>Umbraco.Community.DynamicImages</PackageId>
    <Product>Umbraco.Community.DynamicImages</Product>
    <Title>Dynamic Images</Title>
    <Version>2.0.0</Version>
    <Authors>Paul Seal</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Paul Seal</Copyright>
    <Description>Generates Open Graph / social share images from your content on publish, designed in a drag-and-drop backoffice section instead of hand-written configuration.</Description>
    <PackageTags>umbraco;umbraco-marketplace;opengraph;og-image;social;images;backoffice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/prjseal/Umbraco.Community.DynamicImages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/prjseal/Umbraco.Community.DynamicImages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Keep the npm workspace out of static web assets and the package -->
    <Content Remove="Client\**" />
    <None Include="Client\**" Pack="false" />
  </ItemGroup>
</Project>
