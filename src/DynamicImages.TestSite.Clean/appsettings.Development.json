{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Hosting": {
        "Debug": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportOnFirstBoot": true
    }
  },

  "//": [
    "A v1 DynamicImages block, imported into a v2 template ('Clean Bean OG Image') the first time",
    "this site boots against an empty template table - see AutoImportLegacyConfig in the Dynamic",
    "Images README. It builds a Clean Bean Cafe (https://cleanbeancafe.co.uk) branded social share",
    "image for the Article doc type: brand mark, title and tagline baked into the background at",
    "/assets/img/og/clean-bean-background.png, with the page title, subtitle, article date and",
    "main image drawn on top per page. Editing the layers below no longer changes what renders",
    "once imported - open the template in the Dynamic Images backoffice designer instead."
  ],
  "DynamicImages": {
    "Enabled": true,
    "Instructions": [
      {
        "MediaFolder": "Social Images",
        "DocTypeAliases": [ "article" ],
        "TargetPropertyAlias": "socialImage",
        "SourceImagePath": "/assets/img/og/clean-bean-background.png",
        "Layers": [
          {
            "LayerType": 1,
            "SourcePropertyAlias": "mainImage",
            "xPosition": 760,
            "yPosition": 95,
            "Width": 380,
            "Height": 440,
            "CornerRadius": 20,
            "Opacity": 1.0
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "name",
            "xPosition": 64,
            "yPosition": 210,
            "MaxWidth": 620,
            "Colour": "#F2EFE6",
            "Font": "BricolageDisplay_Title",
            "LineSpacing": 1.15
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "subtitle",
            "xPosition": 64,
            "yPosition": 456,
            "Colour": "#C4CADD",
            "Font": "HankenBody_Subtitle"
          },
          {
            "LayerType": 0,
            "SourcePropertyAlias": "articleDate",
            "DateFormat": "d MMMM yyyy",
            "xPosition": 64,
            "yPosition": 560,
            "Colour": "#9AA0B5",
            "Font": "HankenMeta_Meta"
          }
        ]
      }
    ],
    "Fonts": [
      {
        "FamilyName": "BricolageDisplay",
        "Path": "/assets/fonts/BricolageGrotesque-ExtraBold.woff2",
        "Styles": [
          { "Name": "Title", "Size": 58, "Style": 0 }
        ]
      },
      {
        "FamilyName": "HankenBody",
        "Path": "/assets/fonts/HankenGrotesk-Regular.woff2",
        "Styles": [
          { "Name": "Subtitle", "Size": 30, "Style": 0 }
        ]
      },
      {
        "FamilyName": "HankenMeta",
        "Path": "/assets/fonts/HankenGrotesk-SemiBold.woff2",
        "Styles": [
          { "Name": "Meta", "Size": 24, "Style": 0 }
        ]
      }
    ]
  }
}
