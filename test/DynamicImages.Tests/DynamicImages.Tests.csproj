<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Umbraco.Community.DynamicImages.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicImages\Umbraco.Community.DynamicImages.csproj" />
    <!-- The uSync serializers are driven directly by USync*SerializerTests; this pulls in
         uSync.Extend, uSync.BackOffice and uSync.Core with it. -->
    <ProjectReference Include="..\..\src\DynamicImages.uSync\Umbraco.Community.DynamicImages.uSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real font, so the text-fitting and renderer tests measure real glyphs. -->
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fixture the client's anchor.test.ts asserts against. -->
    <None Include="..\..\src\DynamicImages\Client\src\models\anchor-fixtures.json"
          Link="anchor-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\DynamicImages\Client\src\models\relative-layout-fixtures.json"
          Link="relative-layout-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\DynamicImages\Client\src\models\rotation-fixtures.json"
          Link="rotation-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\DynamicImages\Client\src\models\shape-fixtures.json"
          Link="shape-fixtures.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
